# Terraform
#
# .terraform/ holds the downloaded provider binaries - 659 MB for the AWS
# provider alone, and machine-specific.
#
# State is excluded because it holds RESOLVED SECRET VALUES in plaintext, and
# because a state file in git means two people applying concurrently silently
# overwrite each other's infrastructure. Use an S3 backend with DynamoDB
# locking instead.
#
# .tfvars is excluded because that is where account ids, subnet ids and secret
# ARNs get written while iterating.
#
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions
# and hashes, and committing it is what makes a plan reproducible.
deploy/aws/.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
tfplan

# Generated by the bootstrap scripts. These hold real account ids, subnet ids
# and secret ARNs for whichever stack was last deployed from this checkout,
# which is per-machine state rather than anything to share.
deploy/aws/*.auto.tfvars
deploy/aws/.weights-digests

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
