# Secrets. Never commit a filled-in environment file.
.env
*.env
!.env.example
deploy/.env
deploy/tls/
*.pem
*.key

# Model weights and caches
checkpoints/
models/
*.ckpt
*.pt
*.pth

# Test audio dropped at the repo root, never committed. Anchored with a
# leading slash: the bare pattern `audio` matches a directory of that name at
# any depth, which silently excluded the src/labs/audio package - real source,
# imported by analysis/audio.py - from every clone.
/audio/

# Test fixtures: audio is not committed
tests/fixtures/audio/*
!tests/fixtures/audio/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-*/
venv/
# Benchmark output: raw JSON per run plus the rendered PDF. Reproducible from
# scripts/aws_benchmark.py given the same --seed, so it is not worth versioning.
benchmarks/
env/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/

# Terraform
#
# .terraform/ holds the downloaded provider binaries - 659 MB for the AWS
# provider alone, and machine-specific.
#
# State is excluded because it holds RESOLVED SECRET VALUES in plaintext, and
# because a state file in git means two people applying concurrently silently
# overwrite each other's infrastructure. Use an S3 backend with DynamoDB
# locking instead.
#
# .tfvars is excluded because that is where account ids, subnet ids and secret
# ARNs get written while iterating.
#
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions
# and hashes, and committing it is what makes a plan reproducible.
deploy/aws/.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
tfplan

# Generated by the bootstrap scripts. These hold real account ids, subnet ids
# and secret ARNs for whichever stack was last deployed from this checkout,
# which is per-machine state rather than anything to share.
deploy/aws/*.auto.tfvars
# Written by 00-backend.sh. The bucket name embeds the account id, so this is
# per-account config rather than something to commit.
deploy/aws/backend.hcl
deploy/aws/.weights-digests

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store

# Terraform plan files embed variable values, including secrets.
tfplan-*

# Frontend (beat22LABS). Dependencies and build output only - the source is
# committed. Anchored to that directory so these names cannot swallow
# anything under src/, which is the mistake the bare `audio` pattern above
# used to make.
/beat22LABS/node_modules/
/beat22LABS/.next/
/beat22LABS/out/
/beat22LABS/.turbo/
/beat22LABS/next-env.d.ts
