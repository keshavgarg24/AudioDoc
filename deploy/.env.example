# Copy to .env and fill in every value marked REQUIRED.
# Never commit .env — it holds secrets.
#
#   cp .env.example .env
#   # edit .env
#   docker compose -f deploy/docker-compose.yml up -d --build

# ─────────────────────────────────────────────────── identity / versioning ──
LABS_API_VERSION=1.1.0

# ──────────────────────────────────────────────────────────── auth / keys ──
# REQUIRED in production. Without this the API is open to anyone.
LABS_REQUIRE_AUTH=true

# Bootstrap key(s) for the very first deploy. Comma-separated, no spaces.
# Once MongoDB is up, prefer database-backed keys:
#   docker compose exec api labs-keys create --name "partner" --scopes analyze,read
LABS_API_KEYS=

# Exact, comma-separated origins that may call the API from a browser.
# Never use "*" with auth enabled — it allow-lists every origin on the internet.
# Example: LABS_CORS_ORIGINS=https://studio.yourapp.com,https://app.yourapp.com
LABS_CORS_ORIGINS=

# Per-key sliding-window rate limit (requests per 60 s). 0 = no limit.
LABS_RATE_LIMIT_PER_MIN=60

# Per-key concurrent analysis cap. Protects the job queue from a single caller.
LABS_MAX_INFLIGHT_PER_KEY=4

# ──────────────────────────────────────────────────────────────── storage ──
# REQUIRED for deduplication, result retention, and API key management.
# Without this every submission runs the full pipeline, including retries.
# Example: LABS_MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true
LABS_MONGO_URI=
LABS_MONGO_DB=labs

# Retention. 0 = KEEP FOREVER, and that is the default for all three.
#
# The audio, the reports and the features are the dataset: deduplication reads
# them, appeals are re-analysed from them, and they are the only corpus that
# exists if the models are ever retrained. Set a positive value only if a
# retention policy requires deletion - a TTL index deletes, it does not
# archive, and it only affects documents written after the change.
LABS_RESULT_TTL_DAYS=0
# Days before uploaded audio is expired from the bucket. 0 = keep forever.
LABS_AUDIO_TTL_DAYS=0
# Seconds a retained Level-1 result is kept for appeal. 0 = keep forever.
LABS_SCREEN_RETAIN_S=0

# Store the analysed audio file in object storage. Leave LABS_AUDIO_BUCKET
# empty to skip storage (recommended until you need playback or audit logs).
LABS_STORE_AUDIO=false
LABS_AUDIO_BUCKET=
LABS_AUDIO_PREFIX=uploads
LABS_S3_REGION=

# ─────────────────────────────────────────────────────────── model weights ──
# Mirror weights to a private S3 bucket once, then keep OFFLINE=true.
# This prevents a running deployment from silently pulling gigabytes
# over the public internet when a worker restarts.
# Example: LABS_MODELS_S3_URI=s3://your-private-bucket/labs-models
LABS_MODELS_S3_URI=

# REQUIRED in production. Refuse to reach Hugging Face at runtime.
LABS_OFFLINE=true

# Pin to a specific commit SHA so the model cannot change under a live deployment.
# Find the commit from: git log in the checkpoints repo.
# Leave empty only during initial setup.
LABS_CKPT_REVISION=

# Local directory inside the container where weights are stored.
# Matches the volume mount in docker-compose.yml — do not change independently.
LABS_CKPT_DIR=/models/checkpoints
LABS_MODELS_DIR=/models

# ──────────────────────────────────────────────────────── model / compute ──
# Set to the number of PHYSICAL CORES on the host (not vCPUs).
# Two hyperthreads on one core contend on matrix multiply; half the vCPU
# count is correct on every current x86 instance type.
#   4 vCPU  → 2   |   8 vCPU  → 4   |   16 vCPU  → 8
LABS_TORCH_THREADS=4

# Worker threads for background jobs. Match to physical core count.
# Each thread runs one analysis at a time; this is your throughput ceiling.
LABS_JOB_WORKERS=4

# Maximum simultaneously accepted analyses (across all threads).
# Must be >= LABS_JOB_WORKERS. Extra submissions queue and are served in order.
LABS_MAX_CONCURRENCY=4

# Leave empty. Enabling autocast changes the model numerics; a track near the
# decision boundary may flip verdict. Treat enabling this as a model change
# and re-validate before shipping.
LABS_AUTOCAST_DTYPE=

# ────────────────────────────────────────────────────────────── uploads ──
# Maximum file size in megabytes.
LABS_MAX_UPLOAD_MB=50

# Maximum audio duration to process. Longer files are truncated to this.
LABS_MAX_DURATION_S=900

# Comma-separated allowed file extensions (include the dot).
LABS_ALLOWED_SUFFIXES=.wav,.mp3,.flac,.m4a,.aac,.ogg,.opus

# ────────────────────────────────────────────────────────────── webhooks ──
# REQUIRED if any caller uses webhook_url. Without it deliveries are unsigned
# and a receiver cannot verify authenticity.
# Generate with: openssl rand -hex 32
LABS_WEBHOOK_SECRET=

# How many times to retry a failed webhook delivery before giving up.
LABS_WEBHOOK_RETRIES=3

# ──────────────────────────────────────────────────────── security headers ──
# Strict-Transport-Security max-age in seconds. 0 omits the header.
# Set to 31536000 (one year) ONLY once TLS is terminated in front of the
# service and every subdomain is served over HTTPS — the header is sticky in
# browsers and a premature one makes a plain-HTTP host unreachable.
LABS_HSTS_SECONDS=0

# Serve /docs, /redoc and /openapi.json. The schema enumerates every route,
# parameter and error code. Set false on an internet-facing deployment and
# publish the documentation separately.
LABS_EXPOSE_DOCS=false

# ─────────────────────────────────────────────────────────────── shutdown ──
# Seconds to let running analyses finish before the worker pool is dropped.
# MUST be lower than the orchestrator's termination grace period, or the
# container is killed mid-drain and the wait bought nothing:
#   docker compose  stop_grace_period (see docker-compose.yml, default 45s)
#   kubernetes      terminationGracePeriodSeconds
LABS_SHUTDOWN_DRAIN_S=30

# ─────────────────────────────────────────────────────────────── runtime ──
LABS_LOG_LEVEL=INFO

# "json" emits one JSON object per line with the request id on every record,
# which is what a log shipper wants. "text" is human-readable for local work.
LABS_LOG_FORMAT=json

# Memory ceiling for the API container. The model weights plus working buffers
# are roughly 4–6 GB. 12 GB is comfortable for an 8-core host.
LABS_MEMORY_LIMIT=12g

# Docker image tag to deploy. Pin to a specific tag in production.
LABS_IMAGE_TAG=latest

# ═══════════════════════════════════════════════════ level 1: the screen ══
# Two small ONNX detectors, ~1.2 MB, no torch. Free and ungated, so its cost
# is a product decision as much as an engineering one. Measured at ~1.5 s.
LABS_SCREEN=true

# In-flight screens before the endpoint returns 429. Level 1 is CPU-bound and
# FastAPI would run it on a 40-thread pool, where 40 concurrent screens on
# 4 cores do not run faster - they run at the same aggregate throughput with
# 40x the latency. Blank means the vCPU count, capped at 8.
LABS_SCREEN_CONCURRENCY=

# Windows the CNN median-pools over. Upstream used 40; the pooling is a
# median, which converges quickly, and CQT is the dominant cost in this tier.
LABS_SCREEN_CNN_SEGMENTS=16

# Whether Level 1 may end an `ai` request when it is decisively AI. This is
# the tier's whole economic case: it removes 30-90 s of backbone CPU from the
# requests that need it least.
#
# Only the AI side can exit. A confident "human" always escalates, because
# both Level-1 models recognise only the generators they were trained on and
# their silence is not evidence.
LABS_SCREEN_EXIT_ON_AI=true

# ═════════════════════════════════════════════════════ level 2: the deep ══
# Distribute the 48 Stage-1 windows across the WHOLE track instead of taking
# the first 48 downbeats. Measured coverage went 0.77 -> ~0.98 at identical
# cost. Set false to restore upstream's behaviour for A/B work.
LABS_SEGMENT_SPREAD=true

# Two-pass Stage-1: stride 3 first, full density only when |logit| < 5.
# Justified by measurement - at or above 5 the verdict is immune to segment
# count, below 2 it can flip - and escalation recomputes nothing.
LABS_CASCADE=true
LABS_CASCADE_STRIDE=3
LABS_CASCADE_ESCALATE_BELOW=5.0

# Report `inconclusive` when |logit| is inside the band, instead of
# publishing the sign of a coin flip. ai1.mp3 sits at |logit| 0.4 and lands on
# either side of zero depending only on which windows were analysed.
LABS_DEEP_BANDING=true
LABS_INCONCLUSIVE_BELOW=2.0

# ══════════════════════════════════════════════════════════════ gating ════
# Require the `deep` scope for mode=ai and mode=full.
#
# BREAKING: keys carrying `analyze` get `screen` but NOT `deep` and must be
# granted it explicitly:
#     labs-keys create --name "upload loop" --scopes analyze,read,deep
#
# Set 0 to restore the previous fully-open behaviour. Right for local
# development and for a deployment already behind its own gateway.
LABS_GATE_DEEP=true

# ═════════════════════════════════════════════ distributed mode (SQS) ═════
# Leave BOTH of these blank for the single-container deployment, which uses
# the in-process queue and is the right call for one box.
#
# Distributed mode needs the queue AND persistence: SQS carries the work and
# MongoDB carries the state. With only the first, a job accepted by one API
# container and finished by a worker is unreportable and the submitter polls
# forever.
LABS_SQS_QUEUE_URL=

# Must exceed the slowest analysis, or SQS hands the message to a second
# worker mid-run and the track is analysed twice at full cost. The worker also
# heartbeats the deadline outward while it holds a message.
LABS_SQS_VISIBILITY_S=900

# REQUIRED in distributed mode. The worker is a different container and cannot
# read the API container's temp directory.
# LABS_AUDIO_BUCKET=

# ══════════════════════════════════════════ secondary verification (ACR) ══
# A catalogue lookup against known generated audio. A positive match is
# STRONGER evidence than the local model's statistical inference, so the
# consensus treats it as authoritative when it responds.
#
# The provider is never named in any API response; that boundary is enforced
# in services/acrcloud.py and services/consensus.py.
ACR_HOST=
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=

# ACRCloud's own documented threshold for ai_probability. A policy knob, not a
# property of their API: lower it to catch more and review more, raise it for
# near-certain matches only.
LABS_ACR_THRESHOLD=50.0

# When a caller does not pass `verify`. "never" means the local model alone
# decides, which is the historical default and leaves a configured provider
# entirely unused - set "auto" once ACR is wired up, so verification runs
# whenever the local result is weak.
#   never   the local model alone
#   auto    verify only when the local result is weak
#   always  verify every request
LABS_VERIFY_DEFAULT=never

# Let the consensus verdict replace the headline `prediction`/`verdict`.
#
# Without this the consensus block is decorative: it can conclude that
# verification overrode the local model while the top-level `prediction` still
# says what the local model thought - and every caller reads the top-level
# field. The primary result is preserved verbatim under `detection.primary`
# and `verdict_source` records which one is on top.
LABS_PROMOTE_CONSENSUS=true

# ═══════════════════════════════════════════════ checkpoint provenance ════
# Expected SHA-256 of each Stage checkpoint. Blank means "do not check".
#
# This is NOT the same as pinning LABS_CKPT_REVISION. A revision pins what we
# ASK FOR; these pin what we GOT, and they cover different failures: a
# revision cannot detect a corrupted download, a truncated S3 copy, a stale
# file left on a reused volume, or a mirror bucket somebody else can write to.
#
# A silently different checkpoint does not error - it answers confidently and
# wrongly in your name, which is exactly the failure worth paying a few
# seconds of startup hashing to catch.
#
# The values below are the pair this repo was measured against:
#     shasum -a 256 checkpoints/Stage-*.ckpt
LABS_STAGE1_SHA256=f9099df5c618a2f92bcd8f4ba48d1c6606f2e4610385b8eea4a03f1a7319629f
LABS_STAGE2_SHA256=ed133c261c5d367fc6adf53813a5c93b62a59de5bef546cf5899a5c157eba7a0

# Refuse to start on a mismatch rather than logging and carrying on. A
# checkpoint that is not the one you pinned is not a degraded service, it is a
# different model.
LABS_ENFORCE_CKPT_DIGEST=true
