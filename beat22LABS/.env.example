# Copy to .env.local for development. On Vercel these go in
# Settings -> Environment Variables.
#
# EVERY variable here is read at BUILD time and baked into the output. A
# change in the Vercel dashboard does nothing until the next deploy.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The backend's origin. Every /api/* call is rewritten here at the edge.
# Must be a public origin: the rewrite is resolved by Vercel, not by the
# browser, so a localhost value resolves to the loopback address of the
# serving infrastructure and the whole API 404s. The build refuses to
# complete if this is missing or private.
API_TARGET=https://api.example.com

# The backend deploys with LABS_REQUIRE_AUTH=true, so without a key every
# route answers 401 and nothing on the site works.
#
# NEXT_PUBLIC_ means this is compiled into the browser bundle and any visitor
# can read it. Publish only a key you are willing to have public:
#   - scopes `screen` and `analyze` ONLY - never `deep` or `admin`
#   - a daily quota and a per-minute rate limit
#   - rotated like any other public credential
#
# The deep tier (mode=ai and mode=full) is billable and needs the `deep`
# scope. Do not put a deep key here; call that from a server you control.
NEXT_PUBLIC_LABS_API_KEY=labs_live_...

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Canonical origin, used for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://labs.beat22.com

# Absolute backend URL, bypassing the /api/* rewrite. Only for hosting that
# cannot rewrite. This makes every call cross-origin, so the backend must
# then name this site in LABS_CORS_ORIGINS - and a 50 MB upload gains a
# CORS preflight it does not otherwise have.
# NEXT_PUBLIC_API_URL=https://api.example.com

# Allows a production build against a localhost backend. Only for a
# deliberate local `next build`; never set this on Vercel.
# ALLOW_LOCALHOST_API_TARGET=1
